{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CleverCove",
  "version": "0.3.0",
  "identifier": "com.clevercove.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CleverCove",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 650,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Private educational practice games",
    "longDescription": "A local-first educational app with child-friendly practice games and private parent-managed settings.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "displayLanguageSelector": false }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/ooberguts/clever-cove/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE2MkIwOUQ1OUEzRUY1QjIKUldTeTlUNmExUWtycHRRd0dpNzRuK01vSjNJenZtQkp5UHkwVkcxS1h3VStONDl5MEdtN0xXNzcK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
